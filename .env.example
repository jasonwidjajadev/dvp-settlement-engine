# Copy this file to .env and replace placeholders.
# Spring Boot does not load .env automatically. Export these variables
# before ./mvnw spring-boot:run, for example:
#   set -a && source .env && set +a && ./mvnw spring-boot:run

POSTGRES_DB=dvp
POSTGRES_USER=dvp
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dvp
SPRING_DATASOURCE_USERNAME=dvp
SPRING_DATASOURCE_PASSWORD=change-me
