# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Mac
.DS_Store

# Maven
target/

# Keep the Maven Wrapper jar committable. The Package Files section ignores *.jar,
# which would otherwise exclude .mvn/wrapper/maven-wrapper.jar.
!.mvn/wrapper/maven-wrapper.jar

# Local environment and secrets
.env
.env.*
!.env.example
